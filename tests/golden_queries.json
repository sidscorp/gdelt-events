{
  "description": "Curated query corpus for dashboard regression testing. Each entry is a set of query params sent to /api/articles, plus assertions. Add a new case by appending to the queries array — no code change required.",
  "queries": [
    {
      "id": "gal_1h_baseline",
      "params": {"source": "gal", "hours": 1},
      "min_results": 100,
      "max_latency_s": 2.5,
      "description": "GAL 1h baseline — must have hundreds of recent articles."
    },
    {
      "id": "gal_search_apple",
      "params": {"source": "gal", "hours": 24, "q": "apple"},
      "min_results": 1,
      "max_latency_s": 2.5
    },
    {
      "id": "gal_title_recall",
      "params": {"source": "gal", "hours": 168, "title": "recall"},
      "min_results": 10,
      "max_latency_s": 8.0,
      "description": "Recall keyword in titles — key signal for FDA supply chain use case. Slow because ILIKE full-scans GAL (no text index yet)."
    },
    {
      "id": "gal_language_english",
      "params": {"source": "gal", "hours": 1, "language": "en"},
      "min_results": 50,
      "max_latency_s": 2.5
    },
    {
      "id": "gal_language_spanish",
      "params": {"source": "gal", "hours": 6, "language": "es"},
