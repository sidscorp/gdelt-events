# GDELT Monitor — environment a fresh checkout needs
# (not shipped in git by design — values live in data/ and the box, never the repo)

# --- REQUIRED at runtime ---
# LLM gateway key for judge + briefings + editor. PLACEHOLDER NAME IS A LIE:
# the file is named data/.openrouter_key but it holds a LiteLLM virtual key
# (llm.snambiar.com), NOT an OpenRouter key. The real OpenRouter key is parked
# at data/.openrouter_key.orig.
#   Value source: ~/projects/llm-gateway on snambiar-linux (app-keys.txt, key 'gdelt').
OPENROUTER_API_KEY=<litellm virtual key for the gdelt app>

# --- OPTIONAL ---
# OpenAI-compatible base override if you bypass the LiteLLM gateway (rare).
OPENROUTER_API_BASE=https://llm.snambiar.com/v1

# Observability; briefing/trace cost attribution degrades silently without it.
LANGFUSE_HOST=https://langfuse.snambiar.com
LANGFUSE_PUBLIC_KEY=<pk>
LANGFUSE_SECRET_KEY=<sk>

# Running without the background workers (embed/classify chains).
# Required by tests and by `embed_new_articles.py --status` contexts.
GDELT_DISABLE_WORKERS=1

# Data dir override when the repo is cloned somewhere without the standard layout.
GDELT_DATA_DIR=C:\path\to\gdelt-events\data

# Ollama host for embeddings (semantic net, pill nomination, clustering).
# Default: http://localhost:11434 — on the rebuild box this must exist or
# every semantic surface degrades silently while the feed keeps serving keywords.
OLLAMA_URL=http://localhost:11434/api/embed
