[Unit]
Description=GDELT News Dashboard
After=network.target

[Service]
User=snambiar
WorkingDirectory=/home/snambiar/projects/analytics-projects/gdelt-events/dashboard
ExecStart=/home/snambiar/projects/analytics-projects/gdelt-events/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8015 --timeout 30 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
