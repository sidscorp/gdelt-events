[Unit]
Description=GDELT v2 data ingest run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=snambiar
WorkingDirectory=/home/snambiar/projects/analytics-projects/gdelt-events
ExecStart=/home/snambiar/projects/analytics-projects/gdelt-events/.venv/bin/python gdelt_ingest.py
TimeoutStartSec=300
Nice=15
IOSchedulingClass=idle
