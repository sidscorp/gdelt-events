    {
      "id": "gal_supply_chain_3d",
      "params": {"source": "gal", "hours": 72, "q": "supply chain"},
      "min_results": 1,
      "max_latency_s": 15.0,
      "description": "Supply chain sanity floor. ILIKE on 4 GAL text columns is a full scan; larger time windows hit the per-connection memory limit and 503. Needs an FTS index or a materialized candidate table to scale."
    },
    {
      "id": "gal_factory_fire_week",
      "params": {"source": "gal", "hours": 168, "q": "factory fire"},
      "min_results": 1,
      "max_latency_s": 20.0,
      "description": "Narrower text-search regression. Tracks real current performance — failures here mean text-search has gotten worse since the split."
    },
    {
      "id": "gkg_1h_baseline",
